        document.querySelectorAll('.nav-item').forEach(item => { item.addEventListener('mousemove', e => { const r = item.getBoundingClientRect(); item.style.setProperty('--pos-x', (e.clientX - r.left) + 'px'); item.style.setProperty('--pos-y', (e.clientY - r.top) + 'px'); }); item.addEventListener('mouseleave', () => { item.style.setProperty('--pos-x', '50%'); item.style.setProperty('--pos-y', '50%'); }); item.addEventListener('click', e => { if (item.classList.contains('nav-sep') || item.classList.contains('nav-special') || item.classList.contains('nav-outsource')) return; const r = item.getBoundingClientRect(); item.style.setProperty('--ripple-x', (e.clientX - r.left) + 'px'); item.style.setProperty('--ripple-y', (e.clientY - r.top) + 'px'); item.classList.remove('ripple'); void item.offsetWidth; item.classList.add('ripple'); document.querySelectorAll('.nav-item').forEach(i => { if (!i.classList.contains('nav-sep') && !i.classList.contains('nav-special') && !i.classList.contains('nav-outsource')) i.classList.remove('active'); }); item.classList.add('active'); filterProducts(item.textContent.toLowerCase().trim()); }); });

